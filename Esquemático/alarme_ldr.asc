TEXT 32 -40 Left 2 ;ALARME COM LDR - Esquematico eletrico (Arduino Uno)\nPinagem conforme sketch_alarme_ldr.ino / config.h (fonte da verdade - a tabela antiga da nota estava desatualizada)
TEXT 40 56 Left 2 ;ARDUINO UNO
TEXT 232 80 Left 2 ;5V
TEXT 152 160 Left 2 ;A0 (LDR)
TEXT 136 240 Left 2 ;D12 (ARM)
TEXT 152 320 Left 2 ;D13 (SIL)
TEXT 96 400 Left 2 ;D8 (LED verde)
TEXT 56 480 Left 2 ;D7 (LED vermelho)
TEXT 128 560 Left 2 ;D2 (buzzer)
TEXT 160 640 Left 2 ;A4 (SDA)
TEXT 160 720 Left 2 ;A5 (SCL)
TEXT 208 808 Left 2 ;GND
TEXT 896 432 Left 2 ;RLDR = LDR (fotoresistor)\nvaria ~1k (claro) a >1M (escuro)\nvalor fixo aqui so para simulacao estatica do ponto DC
TEXT 856 208 Left 2 ;S1 ARMAR/DESARMAR (D12)\nbotao momentaneo NA, mostrado aberto (repouso)\nINPUT_PULLUP interno - sem resistor externo\nsegurar define o delay de saida
TEXT 440 216 Left 2 ;S2 SILENCIAR/RESET (D13)\nbotao momentaneo NA, mostrado\naberto INPUT_PULLUP interno -\nsem resistor externo
TEXT 440 48 Left 2 ;LED1 verde (D8)\nindicador ARMADO
TEXT 712 48 Left 2 ;LED2 vermelho (D7)\nindicador DISPARADO
TEXT 440 440 Left 2 ;BZ1 = buzzer piezo passivo\n(acionado via tone() no pino D2)\nvalor 40R e so um placeholder\neletrico para fechar a malha \nna simulacao
TEXT 456 720 Left 2 ;OLED SSD1306 128x64 (I2C)
